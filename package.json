{
    "name": "dnd-pitched-battles",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist/dist-be/main.js",
    "scripts": {
        "dev:fe": "vite",
        "dev:be": "cross-env NODE_ENV=development electron .",
        "build:fe": "tsc -b && vite build",
        "build:be": "tsc --project src/be/tsconfig.json",
        "build": "npm run build:be && npm run build:fe",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "build:mac": "npm run build:be && npm run build:fe && electron-builder --mac --arm64",
        "build:win": "npm run build:be && npm run build:fe && electron-builder --win --x64",
        "build:linux": "npm run build:be && npm run build:fe && electron-builder --linux --x64"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.ts": "prettier --write"
    },
    "dependencies": {
        "@radix-ui/react-icons": "^1.3.2",
        "classnames": "^2.5.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@electron/remote": "^2.1.2",
        "@eslint/js": "^9.21.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "cross-env": "^7.0.3",
        "electron": "^35.0.0",
        "electron-builder": "^25.1.8",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.3",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0"
    }
}
